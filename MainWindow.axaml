<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:gymmmm.ViewModels"
        xmlns:models="using:gymmmm.Models"
        x:Class="gymmmm.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="GymTrack"
        Width="650"
        Height="850">

    <ScrollViewer>

        <StackPanel
            Margin="30"
            Spacing="12">

            <!-- TITEL -->

            <TextBlock
                Text="GymTrack"
                FontSize="32"
                FontWeight="Bold"/>


            <!-- NEUES TRAINING -->

            <TextBlock
                Text="Neues Training"
                FontSize="22"
                FontWeight="Bold"/>


            <TextBlock Text="Name des Trainings"/>

            <TextBox
                Text="{Binding TrainingName}"
                Watermark="z.B. Push Day"/>


            <!-- NEUE ÜBUNG -->

            <TextBlock
                Text="Neue Übung"
                FontSize="20"
                FontWeight="Bold"
                Margin="0,15,0,0"/>


            <TextBlock Text="Übung"/>

            <TextBox
                Text="{Binding NewExercise}"
                Watermark="z.B. Bankdrücken"/>


            <TextBlock Text="Gewicht in kg"/>

            <TextBox
                Text="{Binding NewWeight}"
                Watermark="z.B. 60"/>


            <TextBlock Text="Sätze"/>

            <TextBox
                Text="{Binding NewSets}"
                Watermark="z.B. 3"/>


            <TextBlock Text="Wiederholungen"/>

            <TextBox
                Text="{Binding NewRepetitions}"
                Watermark="z.B. 10"/>


            <Button
                Content="Übung hinzufügen"
                Command="{Binding AddExerciseCommand}"/>


            <!-- AKTUELLE ÜBUNGEN -->

            <TextBlock
                Text="Aktuelle Übungen"
                FontSize="20"
                FontWeight="Bold"
                Margin="0,15,0,0"/>


            <TextBlock
                Text="Klicke eine Übung an, wenn du sie löschen möchtest."/>


            <ListBox
                ItemsSource="{Binding Exercises}"
                SelectedItem="{Binding SelectedExercise, Mode=TwoWay}"
                Height="180">

                <ListBox.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:Exercise">

                        <Border
                            Padding="10"
                            Margin="0,5"
                            BorderThickness="1"
                            CornerRadius="5">

                            <StackPanel Spacing="5">

                                <TextBlock
                                    Text="{Binding Name}"
                                    FontSize="17"
                                    FontWeight="Bold"/>

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="15">

                                    <TextBlock
                                        Text="{Binding Weight,
                                        StringFormat='Gewicht: {0} kg'}"/>

                                    <TextBlock
                                        Text="{Binding Sets,
                                        StringFormat='Sätze: {0}'}"/>

                                    <TextBlock
                                        Text="{Binding Repetitions,
                                        StringFormat='Wdh.: {0}'}"/>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>


            <!-- ÜBUNG LÖSCHEN -->

            <Button
                Content="Ausgewählte Übung löschen"
                Command="{Binding DeleteExerciseCommand}"/>


            <!-- TRAINING SPEICHERN -->

            <Button
                Content="Training speichern"
                Command="{Binding CreateTrainingCommand}"
                Margin="0,10,0,0"/>


            <TextBlock
                Text="{Binding StatusMessage}"
                FontWeight="Bold"
                TextWrapping="Wrap"/>


            <!-- GESPEICHERTE TRAININGS -->

            <TextBlock
                Text="Gespeicherte Trainings"
                FontSize="24"
                FontWeight="Bold"
                Margin="0,25,0,5"/>


            <TextBlock
                Text="Wähle ein Training aus."/>

            <ListBox
                ItemsSource="{Binding SavedTrainings}"
                SelectedItem="{Binding SelectedTraining, Mode=TwoWay}"
                Height="180">

                <ListBox.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:Training">

                        <StackPanel Margin="5">

                            <TextBlock
                                Text="{Binding Name}"
                                FontSize="18"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="{Binding ExerciseCount,
                                StringFormat='Übungen: {0}'}"/>

                        </StackPanel>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>


            <!-- TRAINING BEARBEITEN / LÖSCHEN -->

            <StackPanel
                Orientation="Horizontal"
                Spacing="10">

                <Button
                    Content="Training bearbeiten"
                    Command="{Binding EditTrainingCommand}"/>

                <Button
                    Content="Training löschen"
                    Command="{Binding DeleteTrainingCommand}"/>

            </StackPanel>


            <!-- DETAILS -->

            <TextBlock
                Text="Details des ausgewählten Trainings"
                FontSize="22"
                FontWeight="Bold"
                Margin="0,20,0,5"/>


            <ContentControl
                Content="{Binding SelectedTraining}">

                <ContentControl.ContentTemplate>

                    <DataTemplate
                        x:DataType="models:Training">

                        <Border
                            Padding="15"
                            BorderThickness="1"
                            CornerRadius="8">

                            <StackPanel Spacing="8">

                                <TextBlock
                                    Text="{Binding Name}"
                                    FontSize="20"
                                    FontWeight="Bold"/>


                                <ItemsControl
                                    ItemsSource="{Binding Exercises}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate
                                            x:DataType="models:Exercise">

                                            <Border
                                                Padding="8"
                                                Margin="0,3"
                                                BorderThickness="1">

                                                <StackPanel>

                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontWeight="Bold"/>

                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Spacing="15">

                                                        <TextBlock
                                                            Text="{Binding Weight,
                                                            StringFormat='{0} kg'}"/>

                                                        <TextBlock
                                                            Text="{Binding Sets,
                                                            StringFormat='{0} Sätze'}"/>

                                                        <TextBlock
                                                            Text="{Binding Repetitions,
                                                            StringFormat='{0} Wdh.'}"/>

                                                    </StackPanel>

                                                </StackPanel>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ContentControl.ContentTemplate>

            </ContentControl>


            <!-- TRAININGSFORTSCHRITT -->

            <TextBlock
                Text="Trainingsfortschritt"
                FontSize="24"
                FontWeight="Bold"
                Margin="0,25,0,5"/>


            <ItemsControl
                ItemsSource="{Binding ExerciseProgresses}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:ExerciseProgress">

                        <Border
                            Padding="12"
                            Margin="0,5"
                            BorderThickness="1"
                            CornerRadius="8">

                            <StackPanel Spacing="5">

                                <TextBlock
                                    Text="{Binding Name}"
                                    FontSize="18"
                                    FontWeight="Bold"/>

                                <TextBlock
                                    Text="{Binding TimesPerformed,
                                    StringFormat='Gemacht: {0} mal'}"/>

                                <TextBlock
                                    Text="{Binding LastWeight,
                                    StringFormat='Letztes Gewicht: {0} kg'}"/>

                                <TextBlock
                                    Text="{Binding MaxWeight,
                                    StringFormat='Höchstes Gewicht: {0} kg'}"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

    </ScrollViewer>

</Window>